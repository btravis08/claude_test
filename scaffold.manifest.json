{
  "description": "Module ownership map for the create-CLI scaffolder: base always ships; feature modules are copied only when selected. Runtime flags in designops.config.json gate the Studio (schema + desk); scaffold-time selection omits a module's files entirely.",
  "base": [
    "designops.config.json",
    "scaffold.manifest.json",
    "AGENTS.md",
    "src/app/globals.css",
    "src/app/layout.tsx",
    "src/app/sitemap.ts",
    "src/app/(site)/layout.tsx",
    "src/app/(site)/page.tsx",
    "src/app/(site)/[slug]/**",
    "src/app/studio/**",
    "src/app/api/draft-mode/**",
    "src/app/api/revalidate/**",
    "src/components/Navigation.tsx",
    "src/components/SiteFooter.tsx",
    "src/components/PageTransition.tsx",
    "src/components/MotionProvider.tsx",
    "src/components/SmoothScroll.tsx",
    "src/components/home/**",
    "src/components/dev/**",
    "src/components/preview/**",
    "src/components/SectionRenderer.tsx",
    "src/sanity/env.ts",
    "src/sanity/lib/client.ts",
    "src/sanity/lib/fetch.ts",
    "src/sanity/lib/image.ts",
    "src/sanity/lib/redirects.ts",
    "src/sanity/schemaTypes/index.ts",
    "src/sanity/schemaTypes/page.ts",
    "src/sanity/schemaTypes/sections.ts",
    "src/sanity/schemaTypes/navigation.ts",
    "src/sanity/schemaTypes/siteSettings.ts",
    "src/sanity/schemaTypes/blockContent.ts",
    "src/sanity/schemaTypes/redirect.ts",
    "src/sanity/tools/**",
    "src/sanity/theme.ts",
    "src/library/**",
    "src/design/**",
    "src/fonts/**",
    "src/lib/**",
    "scripts/tokens.mjs",
    "scripts/collect-lighthouse.mjs",
    "scripts/audit-sections.mjs",
    "scripts/motion-specs.mjs",
    "scripts/check-design-drift.mjs",
    "scripts/lib/**",
    ".github/workflows/lighthouse-history.yml",
    ".github/workflows/audit.yml",
    ".github/workflows/design-drift.yml",
    ".github/workflows/check-links.yml",
    ".github/workflows/dataset-backup.yml",
    ".github/workflows/fetch-figma-assets.yml",
    "sanity.config.ts",
    "sanity.cli.ts"
  ],
  "commerce": [
    "src/app/(site)/products/**",
    "src/app/(site)/collections/**",
    "src/app/api/search/**",
    "src/app/(site)/search/**",
    "src/components/cart/**",
    "src/components/product/**",
    "src/components/search/**",
    "src/sanity/lib/commerce.ts",
    "src/sanity/lib/cards.ts",
    "src/sanity/lib/search.ts",
    "src/sanity/schemaTypes/product.ts",
    "src/sanity/schemaTypes/collection.ts",
    "src/sanity/schemaTypes/discount.ts",
    "src/sanity/schemaTypes/story.ts",
    "src/sanity/schemaTypes/storeSettings.ts"
  ],
  "blog": [
    "src/app/(site)/journal/**",
    "src/components/journal/**",
    "src/sanity/schemaTypes/blog.ts"
  ],
  "projects": [
    "src/app/(site)/projects/**",
    "src/sanity/schemaTypes/project.ts"
  ],
  "site-specific": {
    "description": "SDR-only content that a scaffold replaces with a sample pack: never copied to new projects.",
    "paths": [
      "src/app/(site)/legacy/**",
      "src/components/legacy/**",
      "src/sanity/schemaTypes/legacyPage.ts",
      "public/figma/**",
      "public/sdr/**",
      "design/sdr-catalog/**",
      "design/figma-tokens/**",
      "scripts/seed.ts",
      "scripts/import-sdr-catalog.ts",
      "scripts/fetch-sdr-catalog.mjs",
      "scripts/fetch-figma-assets.sh"
    ]
  }
}
